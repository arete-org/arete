# Allowlist: `vercel deploy` uploads only what the two services build from.
# Everything else stays home — data/ (database, Garmin tokens), training
# plans, env files, caches — since the CLI does not read .gitignore.
/*
!/src
!/frontend
!/pyproject.toml
!/uv.lock
!/.python-version
!/vercel.json
!/asgi.py
!/scripts
!/README.md

# The frontend typechecks its tests, including this shared Python/TS fixture.
!/tests
/tests/*
!/tests/data
/tests/data/*
!/tests/data/agent-stream-v2.json

**/__pycache__
/frontend/node_modules
/frontend/dist
/frontend/.vite

# Generated from pinned npm packages during prebuild.
/frontend/public/ocr

# Rebuilt and verified by the backend build.
/src/arete/tessdata
