# Database
ARETE_DB=data/arete.duckdb

# Backend
# ARETE_LOG_LEVEL=INFO
# ARETE_AUTO_SYNC_HOUR=9     # local hour of the daily Garmin + Strava sync; keep it after
#                            # wake-up, Garmin only publishes the night's HRV and sleep then.
#                            # "Local" is the container's clock: set TZ too (see docker-compose.yml)

# LLM provider: ollama | openrouter | github
LLM_PROVIDER=ollama
# Optional model override; defaults: ollama=llama3.1:8b,
# openrouter=nvidia/nemotron-3-super-120b-a12b:free,
# github=Meta-Llama-3.1-8B-Instruct. Leave unset to use the provider default.
# LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional LangSmith tracing for the shared coach (chat, briefing, feedback).
# Full agent inputs/outputs, tool results, and memory reads are exported when enabled.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=             # independent of the inference provider's key
# LANGSMITH_PROJECT=Arete        # use the exact project NAME, not its UUID
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=        # only if required by a multi-workspace key

# Dictée vocale des séances : audio -> texte français (le seul flux sortant
# contenant de la voix). STT_PROVIDER=none coupe la fonction entièrement.
# STT_PROVIDER=openrouter
# STT_MODEL=openai/whisper-large-v3-turbo   # ~0,0002 $ la minute dictée
# STT_BASE_URL=https://openrouter.ai/api/v1 # pointer un Whisper local pour rester hors ligne
# STT_API_KEY=sk-or-...                     # à défaut, OPENROUTER_API_KEY est utilisée
# STT_TIMEOUT_S=60
# STT_MAX_AUDIO_MB=10

# OPENROUTER_API_KEY=sk-or-...   # https://openrouter.ai (free-only unless admin flag enabled)
# Settings > Administration > Coach GLM Flash enables the paid model for all athletes.
# Requires LLM_PROVIDER=openrouter and credits. Off by default; no env model change needed.
# GITHUB_TOKEN=ghp_...           # GitHub Models

# Strava OAuth app (https://www.strava.com/settings/api)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback
# FRONTEND_URL=http://localhost:3080

# Garmin Connect (optional: the Settings page can log in interactively)
# Connect Garmin per athlete from Settings > Connections; no shared credentials.
# ARETE_GARMIN_TOKENS_DIR=data/garmin_tokens   # where Garmin session tokens are stored

# Coaching request envelope: set to the actual window configured for your model/server.
# Includes reserved output capacity; routers do not establish a guaranteed window.
# LLM_CONTEXT_TOKENS=65536

# Deployment kill switch; Settings still defaults to athlete opt-out.
GAMIFICATION_ENABLED=true
# Set true only after verifying external authentication covers UI and ALL API URLs.
# FRONTEND_URL=http://localhost:5173  # exact browser origin; fixed consent callback
# VERCEL_OIDC_TOKEN is injected on Vercel; locally: vercel env pull .env.local

# --- Sign-in (README "Who can use it") ---
# Off when unset. With clerk, every API route needs a Clerk session or the API
# key; Google Calendar rides on the Google sign-in (docs/google-calendar.md).
# ARETE_AUTH=clerk
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# Addresses that are the athlete, comma-separated; other accounts wait.
# ARETE_OWNER_EMAIL=you@example.com
# Scripts and the MCP server (Authorization: Bearer); openssl rand -hex 32
# ARETE_API_KEY=
# Optional browser origins allowed to hold a session (token azp).
# ARETE_AUTH_ORIGINS=

# --- Web Push notifications ---
# Generate the pair with: uv run vapid --gen
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com
# Slack app: every athlete, by Slack profile email (docs/slack.md). Unset = disabled.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=T0C7ZT5V0F7
# SLACK_CHANNEL_ID=        # optional dedicated channel; unset = DMs only

# Clerk instance PEM public key (dashboard -> API keys -> JWT public key): sessions are then verified offline.
# CLERK_JWT_KEY=
