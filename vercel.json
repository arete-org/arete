{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "asgi.py",
      "functions": {
        "asgi.py": { "maxDuration": 300 }
      },
      "installCommand": "uv sync --frozen --no-dev --no-install-project",
      "buildCommand": "python scripts/bundle_duckdb_extensions.py && python scripts/bundle_ocr_data.py"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {"path": "/api/cron/automations", "schedule": "0 0 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 1 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 2 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 3 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 4 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 5 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 6 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 7 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 8 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 9 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 10 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 11 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 12 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 13 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 14 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 15 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 16 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 17 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 18 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 19 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 20 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 21 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 22 * * *"},
    {"path": "/api/cron/automations", "schedule": "0 23 * * *"},

    { "path": "/api/cron/checkin", "schedule": "0 5 * * *" },
    { "path": "/api/cron/checkin", "schedule": "0 6 * * *" },
    { "path": "/api/cron/daily-sync", "schedule": "0 7 * * *" },
    { "path": "/api/cron/daily-sync", "schedule": "0 8 * * *" },
    { "path": "/api/cron/daily-sync", "schedule": "0 9 * * *" },
    { "path": "/api/cron/daily-sync", "schedule": "0 10 * * *" },
